# Copy this file to `.env` for local development.
# AgentDeck does not auto-load `.env` globally; source it in your shell or load
# it in your entry script with `python-dotenv`.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Vertex AI (Gemini)
# `VERTEX_PROJECT_ID` is optional if `GOOGLE_APPLICATION_CREDENTIALS_B64`
# decodes to a service-account JSON payload that already includes `project_id`.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_B64=

# To generate the base64 payload from a local service-account file:
#   base64 < /path/to/service-account.json | tr -d '\n'
